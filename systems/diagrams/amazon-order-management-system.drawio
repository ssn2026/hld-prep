          <mxGeometry x="960" y="480" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-paydb" value="Payments DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="590" width="160" height="90" as="geometry" />
