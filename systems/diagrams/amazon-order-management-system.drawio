        <mxCell id="el-gw" value="API Gateway&#10;(routing / rate limiting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="edge-layer">
          <mxGeometry x="20" y="120" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="el-auth" value="Authentication Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="edge-layer">
          <mxGeometry x="20" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="el-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="edge-layer" source="el-lb" target="el-gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el-e2" value="validate token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="edge-layer" source="el-gw" target="el-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1-order" value="Order Service&#10;(orchestrator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-orddb" value="Orders DB&#10;(PostgreSQL)&#10;sharded by user_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p1-inventory" value="Inventory Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-invdb" value="Inventory DB&#10;(PostgreSQL)&#10;sharded by product_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="190" width="160" height="90" as="geometry" />
