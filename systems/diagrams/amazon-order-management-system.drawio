          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="b-client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-gateway" value="Payment Gateway&#10;(external, e.g. Stripe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="270" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-payment" value="Payment Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-paydb" value="Payments DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="400" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-kafka" value="Kafka&#10;topics: payment.completed, payment.failed&#10;(partition key = order_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="255" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b-order" value="Order Service (consumer)&#10;order -&gt; CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="60" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-orddb" value="Orders DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1310" y="160" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-inventory" value="Inventory Service (consumer)&#10;reservation: HELD -&gt; COMMITTED / RELEASED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="420" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-invdb" value="Inventory DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1310" y="520" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-consumers" value="Notification / Analytics /&#10;Search-index&#10;(consume order.lifecycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="260" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-reaper" value="Reservation-expiry reaper&#10;(background job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b-e1" value="1. pays" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="b-client" target="b-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2" value="2. webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="b-gateway" target="b-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2b" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="b-payment" target="b-paydb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e3" value="3. publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="b-payment" target="b-kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e4" value="4a. consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="b-kafka" target="b-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e4b" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="b-order" target="b-orddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e5" value="4b. consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="b-kafka" target="b-inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e5b" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="b-inventory" target="b-invdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e6" value="4c. consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="b-kafka" target="b-consumers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e7" value="if HELD past expires_at: release + restore available_qty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="b-reaper" target="b-inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2-legend-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend-title" value="LEGEND" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="52" y="605" width="100" height="20" as="geometry" />
