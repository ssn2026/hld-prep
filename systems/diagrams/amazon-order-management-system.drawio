          <mxGeometry x="40" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-gateway" value="Payment Gateway&#10;(external)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-payment" value="Payment Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-kafka" value="Kafka&#10;payment.completed / payment.failed&#10;(key = order_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="860" y="250" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b-order" value="Order Service&#10;(consumer)&#10;order -&gt; CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-inventory" value="Inventory Service&#10;(consumer)&#10;reservation HELD -&gt; COMMITTED / RELEASED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1160" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-reaper" value="Reservation-expiry reaper&#10;(HELD past expires_at, no webhook ever arrived)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="420" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b-e1" value="pays (out of band)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-client" target="b-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2" value="webhook: payment result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-gateway" target="b-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e3" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-payment" target="b-kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e4" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-kafka" target="b-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e5" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-kafka" target="b-inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e6" value="release + restore available_qty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-reaper" target="b-inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b-note" value="Both Order Service and Inventory Service consume the SAME event independently off Kafka. Consumers are idempotent by construction: the state-transition WHERE clause (e.g. status = &#39;HELD&#39;) makes redelivery a no-op." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="760" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

