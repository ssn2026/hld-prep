<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="hld-prep" version="24.0.0" type="device">
  <diagram id="page1-architecture" name="1 - Send and Connection Routing">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-clienta" value="Client A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="a-conna" value="Connection Server A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="140" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a-cassandra" value="Cassandra&#10;messages" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="30" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="a-redis" value="Redis&#10;conn:{userId} -&gt; serverId" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="a-connb" value="Connection Server B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a-clientb" value="Client B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="930" y="140" width="140" height="60" as="geometry" /></mxCell>

        <mxCell id="a-e1" value="WebSocket frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-clienta" target="a-conna">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e2" value="write SENT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-conna" target="a-cassandra">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e3" value="lookup recipient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-conna" target="a-redis">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e4" value="route to owning server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-conna" target="a-connb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="390" y="100" /><mxPoint x="790" y="100" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="a-e5" value="push over WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-connb" target="a-clientb">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-note" value="If Redis has no entry for Client B, they're offline — the message just stays SENT in Cassandra and surfaces when B reconnects." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="400" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

