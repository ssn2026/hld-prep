        <mxCell id="edge-layer" value="EDGE LAYER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;container=1;collapsible=0;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="220" height="290" as="geometry" />
        </mxCell>
        <mxCell id="el-lb" value="Load Balancer (L7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="edge-layer">
          <mxGeometry x="20" y="40" width="180" height="60" as="geometry" />
