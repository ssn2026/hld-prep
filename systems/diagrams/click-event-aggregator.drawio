          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e3" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="a-kafka" target="a-stream">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e4" value="flush on watermark" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-stream" target="a-cassandra">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-note" value="The window stays open past its nominal end for a grace period (the watermark) so a click delayed a few seconds by the network still counts, before finalizing and flushing." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
