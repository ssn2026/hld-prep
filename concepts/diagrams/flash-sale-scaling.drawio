        </mxCell>
        <mxCell id="p2-worker" value="Order Worker&#10;(write-behind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="630" y="70" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-ordersdb" value="Orders DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="850" y="65" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-reconciler" value="Reconciler job&#10;(periodic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="630" y="250" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-flagstore" value="Flag Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="850" y="250" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-sqlinv" value="Inventory DB&#10;(PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="630" y="350" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2-e1" value="reserve (Lua script)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p2-client" target="p2-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="order intent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2-redis" target="p2-kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2-kafka" target="p2-worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="INSERT order&#10;(PENDING_PAYMENT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p2-worker" target="p2-ordersdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
