        <mxCell id="b-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="b-created" target="b-pending">
          <mxGeometry relative="1" as="geometry" /></mxCell>
