<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="hld-prep" version="24.0.0" type="device">
  <diagram id="page1-quorum-write" name="1 - Quorum Write Across Replicas">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="340" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="a-coord" value="Coordinator&#10;(any node — no fixed role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="130" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="a-r1" value="Replica A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="30" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="a-r2" value="Replica B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="135" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="a-r3" value="Replica C&#10;(temporarily down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="a-e1" value="PUT(key, value)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-client" target="a-coord">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e2" value="write (parallel)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-coord" target="a-r1">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e3" value="write (parallel)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-coord" target="a-r2">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e4" value="write attempted — times out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="a-coord" target="a-r3">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-note" value="Replica set for this key comes from a consistent-hash ring (not shown literally): only the 3 nodes owning this key's hash range participate. W=2 acks (A, B) are enough to succeed even with C down — a hint for C is stored and replayed when it recovers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="540" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page2-node-storage" name="2 - Node-Local Storage (LSM-Tree)">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="260" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="b-write" value="Incoming write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="b-log" value="Commit Log&#10;(append-only, durability)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="b-memtable" value="Memtable&#10;(in-memory, sorted)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="b-sstable" value="SSTables&#10;(immutable, on disk)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="b-compaction" value="Compaction&#10;(background merge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="b-e1" value="always, first" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="b-write" target="b-log">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e2" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="b-write" target="b-memtable">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e3" value="flush when full" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="b-memtable" target="b-sstable">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e4" value="periodically merges + cleans" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="b-sstable" target="b-compaction">
          <mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
