          <mxGeometry x="30" y="120" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="a-api" value="Ingest API&#10;(validate + publish only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="120" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a-kafka" value="Kafka&#10;click.events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="a-stream" value="Stream Processor&#10;windowed aggregation + HyperLogLog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="a-cassandra" value="Cassandra&#10;page_metrics" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a-e1" value="POST /events/click" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-client" target="a-api">
          <mxGeometry relative="1" as="geometry" /></mxCell>
