        <mxCell id="p2-legend-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend-title" value="LEGEND" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend-text" value="Solid = synchronous, on the request path (Client reserving). Dashed = async/background — Kafka hand-off, write-behind, and everything the periodic reconciler does." style="text;html=1;fontSize=11;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="288" width="530" height="36" as="geometry" />
        </mxCell>
      </root>
