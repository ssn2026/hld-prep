  <diagram id="page1-check-path" name="1 - Check Path Architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-caller" value="Calling Service&#10;(any client's API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-limiter" value="Rate Limiter Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-redis" value="Redis&#10;config cache + counter/bucket state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-sql" value="SQL&#10;clients, rate_limit_rules" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-e1" value="POST /v1/check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-caller" target="a-limiter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e2" value="auth + rule lookup, run Lua script" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-limiter" target="a-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e3" value="on cache miss (rare): SELECT client / rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-limiter" target="a-sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-note" value="Almost every check is answered entirely by Redis. SQL is only touched on a cold cache miss, and to repopulate the cache afterward." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="260" width="480" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

