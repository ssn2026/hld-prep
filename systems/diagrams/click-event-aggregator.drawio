  <diagram id="page1-architecture" name="1 - Ingest, Window, Watermark">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
