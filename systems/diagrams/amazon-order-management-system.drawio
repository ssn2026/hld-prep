        </mxCell>
        <mxCell id="p1-legend-text" value="Synchronous request / response — both directions shown as one double-headed arrow. Every arrow on this page is this kind (no async here — see page 2)." style="text;html=1;fontSize=11;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="155" y="635" width="350" height="40" as="geometry" />
