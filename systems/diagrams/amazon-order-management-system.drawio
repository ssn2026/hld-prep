          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="645" as="sourcePoint" />
            <mxPoint x="140" y="645" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-legend-text1" value="Direct call (webhook receipt handling) or DB read/write." style="text;html=1;fontSize=11;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="155" y="632" width="480" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-legend-line2" style="endArrow=block;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="685" as="sourcePoint" />
            <mxPoint x="140" y="685" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-legend-text2" value="Asynchronous — event on Kafka, an inbound webhook, or a background job. Numbers (1, 2, 3, 4a-c) show the order events actually fire in." style="text;html=1;fontSize=11;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="155" y="672" width="480" height="40" as="geometry" />
        </mxCell>
