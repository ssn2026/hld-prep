          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="read orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2-reconciler" target="p2-ordersdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
