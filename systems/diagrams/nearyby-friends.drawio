<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="hld-prep" version="24.0.0" type="device">
  <diagram id="page1-architecture" name="1 - Authorization Before Geo">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-friend" value="Friend B&#10;(requester)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="a-service" value="Location Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a-session" value="Redis&#10;session:{sharer}:{friend}&#10;(1. checked FIRST)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="30" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="a-geo" value="Redis&#10;friends:geo&#10;(2. only reached if authorized)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="a-e1" value="GET friend's location" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-friend" target="a-service">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e2" value="1. EXISTS check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-service" target="a-session">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-e3" value="2. GEOPOS (only if step 1 passed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-service" target="a-geo">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-note" value="The order is not incidental: authorization gates the geo query entirely -- it is never used to filter results after the fact." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="500" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
