          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="clear flag when reconciled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2-reconciler" target="p2-flagstore">
