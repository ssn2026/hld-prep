<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="hld-prep" version="24.0.0" type="device">
  <diagram id="page1-architecture" name="1 - Startup vs Runtime">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="320" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="a-hdr1" value="STARTUP — once per process" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="a-worker" value="App Server&#10;(embeds the ID library)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="a-sql" value="SQL&#10;worker_id_registry" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="65" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="a-e1" value="INSERT ... ON CONFLICT DO NOTHING (once, ever)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-worker" target="a-sql">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a-hdr2" value="RUNTIME — every ID, no network or DB at all" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="170" width="360" height="24" as="geometry" /></mxCell>
        <mxCell id="a-caller" value="Caller (in-process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a-gen" value="ID library&#10;(same process, no I/O)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="210" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a-e2" value="generate() — in-memory function call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="a-caller" target="a-gen">
          <mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a-note" value="No arrow crosses a process boundary here on purpose — that's the entire design." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="215" width="300" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
