        <mxCell id="se3" edge="1" parent="1" source="s3" target="ssfu" style="edgeStyle=none;rounded=0;html=1;startArrow=block;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se4" edge="1" parent="1" source="s4" target="ssfu" style="edgeStyle=none;rounded=0;html=1;startArrow=block;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Mesh: clients do all the work, breaks down past ~5 people. MCU: server does the most expensive possible work (transcode) for every participant. SFU: server does the cheapest possible work (relay) -- the right default." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="900" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

