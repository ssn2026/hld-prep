<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="hld-prep" version="24.0.0" type="device">
  <diagram id="page1-sync-architecture" name="1 - Sync Checkout Architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-order" value="Order Service&#10;(orchestrator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-inventory" value="Inventory Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a-payment" value="Payment Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="440" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a-e1" value="1. POST /orders&#10;(Idempotency-Key)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-client" target="a-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e2" value="2. reserve(items)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-order" target="a-inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e3" value="reserved / out-of-stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=0;exitY=0.7;entryX=1;entryY=0.3;dashed=1;" edge="1" parent="1" source="a-inventory" target="a-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e4" value="3. create payment intent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-order" target="a-payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e5" value="paymentIntentId + paymentLink" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=0;exitY=0.3;entryX=1;entryY=0.7;dashed=1;" edge="1" parent="1" source="a-payment" target="a-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e6" value="4. orderId + paymentLink" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="a-order" target="a-client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a-note" value="Everything on this page happens inside the client&#39;s original checkout request/response. Payment is not captured here — the client is only handed a link." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="640" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page2-async-flow" name="2 - Async Payment and Event Flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

